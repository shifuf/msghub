<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="84dp"
    android:layout_marginHorizontal="16dp" android:layout_marginVertical="5dp" android:background="@drawable/bg_list_row"
    android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal"
    android:paddingStart="16dp" android:paddingEnd="6dp" android:paddingVertical="12dp">
    <ImageView android:id="@+id/tabIcon" android:layout_width="40dp" android:layout_height="40dp"
        android:background="@drawable/bg_tab_favicon" android:padding="8dp" android:scaleType="centerInside"
        android:src="@drawable/ic_globe" android:contentDescription="@null" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="14dp" android:orientation="vertical">
        <TextView android:id="@+id/tabTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="2" android:textColor="@color/via_text" android:textSize="16sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/tabHost" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="1" android:textColor="@color/via_text_secondary" android:textSize="12sp" />
    </LinearLayout>
    <ImageButton android:id="@+id/tabClose" android:layout_width="48dp" android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/menu_close_tab"
        android:padding="15dp" android:src="@drawable/ic_close" app:tint="@color/via_text_secondary" />
</LinearLayout>
