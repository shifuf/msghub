<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:fitsSystemWindows="true" android:background="@color/via_bg">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" app:navigationIconTint="@color/via_icon" app:titleTextColor="@color/via_text" app:subtitleTextColor="@color/via_text_secondary" />
    <TextView android:id="@+id/conversationOriginal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="20dp" android:layout_marginTop="8dp" android:background="@drawable/bg_list_row" android:padding="16dp" android:maxLines="3" android:ellipsize="end" android:textColor="@color/via_text" android:textSize="15sp" android:lineSpacingExtra="3dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" />
    <LinearLayout android:id="@+id/conversationStatusBar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="20dp">
        <TextView android:id="@+id/conversationStatus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingVertical="12dp" android:textSize="13sp" android:textColor="@color/via_text_secondary" android:accessibilityLiveRegion="polite" />
        <com.google.android.material.button.MaterialButton android:id="@+id/conversationRetry" style="?attr/borderlessButtonStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="重试" android:visibility="gone" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" />
    <LinearLayout android:id="@+id/conversationComposer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom" android:padding="12dp" android:background="@color/via_card">
        <EditText android:id="@+id/conversationInput" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:maxLines="5" android:maxLength="4000" android:inputType="textCapSentences|textMultiLine" android:imeOptions="flagNoEnterAction" android:hint="输入回复" android:textSize="16sp" android:textColor="@color/via_text" android:textColorHint="@color/via_text_secondary" android:background="@drawable/bg_dialog_input" android:padding="12dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/conversationSend" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minWidth="68dp" android:minHeight="48dp" android:layout_marginStart="8dp" android:text="发送" android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
