# =========================
# MsgHub 环境变量
# cp .env.example .env 后按需修改
# =========================

# 运行环境：development | production（自动识别库端口是否映射到本机）
# - development：pnpm db:up 临时映射 127.0.0.1:5432 / 6379
# - production：docker compose up 不映射库端口，不抢宿主机 5432/6379
APP_ENV=development

# ---------- 必改（生产） ----------
JWT_SECRET=change-me-to-a-long-random-string-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe@123456

# ---------- 常用可选 ----------
# SITE_URL=https://notify.example.com
# 生产发送带退订链接的邮件应设置 SITE_URL 为可访问的 HTTPS 根地址。
# TOTP_ENCRYPTION_KEY=独立随机密钥至少32字符，保留安全备份
# 未配置独立密钥时轮换 JWT_SECRET 会使已有 TOTP 密文失效。
# TRUST_PROXY=127.0.0.1/32
# CORS_ORIGINS=https://admin.example.com
ADMIN_PATH=/admin
WEB_PORT=8185

# ---------- 构建版本与可选完整灾备 ----------
# 部署时导出实际提交及 UTC 构建时间；运维页从镜像读取。
# APP_COMMIT=git-revision
# BUILD_TIME=2026-11-20T00:00:00Z
# 仅在配置密钥后用 docker compose --profile backups 启动 runner。
# BACKUP_AGE_IDENTITY_FILE=./data/backup-secrets/identity.txt
# 恢复验证使用私有 tmpfs；需容纳解密后的备份和临时数据库。
# BACKUP_VERIFY_TMPFS_SIZE=2g

# ---------- 本机开发（pnpm dev + pnpm db:up） ----------
# Docker 全栈时 api 固定连容器内 postgres/redis，与下面无关
# PORT=3010
DATABASE_URL=postgresql://msg:msg123456@localhost:5432/msg_notify?schema=public
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# FORCE_RESET_ADMIN_PASSWORD=false
# Optional trusted Alpine package mirror used at image build time.
# ALPINE_MIRROR=https://mirrors.aliyun.com/alpine
